  "avalanche_store_threshold": 8,
  "max_alerts_avalanche": 40,
  "notify_only_in_stock": true,
  "_comment_oos": "Las preventas se publican agotadas/'Próximamente' antes de abrir la reserva. Con esto, un listado NUEVO marcado como prioritario avisa aunque no tenga stock (después avisará otra vez como RESTOCK al abrirse). En One Piece: case/caja/box 🚨 y promos 🎁.",
  "notify_new_oos_priority": true,
  "resync_threshold": 20,
